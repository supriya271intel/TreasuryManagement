@model FinancialSystem.WebUI.Models.FixedDepositViewModel

@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? $"Edit FD #{Model.Id}" : "New Fixed Deposit";
}

<div class="page-header fade-in">
    <h1>@(isEdit ? $"✏ Edit Fixed Deposit #FD-{Model.Id}" : "🏦 New Fixed Deposit")</h1>
    <p>@(isEdit ? "Update the FD details below." : "Enter the Fixed Deposit details for placement and interest tracking.")</p>
</div>

<div class="fs-table-wrap fade-in" style="max-width:900px;">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
        }

        <!-- ── Section: FD Identity ───────────────────────────────────── -->
        <div class="form-section-header">🏷 FD Identity</div>
        <div class="form-grid-2">

            <div class="form-group">
                <label asp-for="FdName" class="form-label"></label>
                <input asp-for="FdName" class="form-control"
                       placeholder="e.g. SBI FD – Q1 2026" />
                <span asp-validation-for="FdName" class="text-danger"></span>
                <small class="form-hint">Descriptive name for easy identification</small>
            </div>

            <div class="form-group">
                <label asp-for="FdNumber" class="form-label"></label>
                <input asp-for="FdNumber" class="form-control"
                       placeholder="e.g. FD123456789" />
                <span asp-validation-for="FdNumber" class="text-danger"></span>
                <small class="form-hint">Bank-issued FD receipt / certificate number</small>
            </div>

        </div>

        <!-- ── Section: Dates & Tenure ───────────────────────────────── -->
        <div class="form-section-header" style="margin-top:1.25rem;">📅 Dates &amp; Tenure</div>
        <div class="form-grid-3">

            <div class="form-group">
                <label asp-for="DepositDate" class="form-label"></label>
                <input asp-for="DepositDate" class="form-control" type="date"
                       id="fd-deposit-date" />
                <span asp-validation-for="DepositDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaturityDate" class="form-label"></label>
                <input asp-for="MaturityDate" class="form-control" type="date"
                       id="fd-maturity-date" />
                <span asp-validation-for="MaturityDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumberOfDays" class="form-label"></label>
                <input asp-for="NumberOfDays" class="form-control" type="number"
                       id="fd-days" placeholder="Auto-computed" readonly />
                <span asp-validation-for="NumberOfDays" class="text-danger"></span>
                <small class="form-hint">Auto-filled from date range; editable if needed</small>
            </div>

        </div>

        <!-- ── Section: Interest & Financials ───────────────────────── -->
        <div class="form-section-header" style="margin-top:1.25rem;">💹 Interest &amp; Financials</div>
        <div class="form-grid-3">

            <div class="form-group">
                <label asp-for="Principal" class="form-label"></label>
                <div class="input-prefix-wrap">
                    <span class="input-prefix">₹</span>
                    <input asp-for="Principal" class="form-control input-with-prefix"
                           type="number" step="1" placeholder="e.g. 1000000"
                           id="fd-principal" />
                </div>
                <span asp-validation-for="Principal" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="InterestRate" class="form-label"></label>
                <div class="input-prefix-wrap">
                    <input asp-for="InterestRate" class="form-control input-with-suffix"
                           type="number" step="0.0001" placeholder="e.g. 7.5000"
                           id="fd-rate" />
                    <span class="input-suffix">% p.a.</span>
                </div>
                <span asp-validation-for="InterestRate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="InterestAmount" class="form-label"></label>
                <div class="input-prefix-wrap">
                    <span class="input-prefix">₹</span>
                    <input asp-for="InterestAmount" class="form-control input-with-prefix"
                           type="number" step="0.01" placeholder="Auto-computed"
                           id="fd-interest" />
                </div>
                <span asp-validation-for="InterestAmount" class="text-danger"></span>
                <small class="form-hint">Simple interest = P × R × D / 36500</small>
            </div>

            <div class="form-group">
                <label asp-for="InterestFrequency" class="form-label"></label>
                <select asp-for="InterestFrequency" class="form-control"
                        asp-items="Html.GetEnumSelectList<FinancialSystem.Domain.Entities.InterestFrequency>()">
                </select>
                <span asp-validation-for="InterestFrequency" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tds" class="form-label"></label>
                <div class="input-prefix-wrap">
                    <span class="input-prefix">₹</span>
                    <input asp-for="Tds" class="form-control input-with-prefix"
                           type="number" step="0.01" placeholder="e.g. 3000.00"
                           id="fd-tds" />
                </div>
                <span asp-validation-for="Tds" class="text-danger"></span>
                <small class="form-hint">TDS @@10% on interest (if applicable)</small>
            </div>

        </div>

        @if (isEdit)
        {
            <!-- ── Audit info (read-only) ─────────────────────────────── -->
            <div class="form-section-header" style="margin-top:1.25rem;">🕐 Audit</div>
            <div class="form-grid-2" style="padding-bottom:1rem;">
                <div class="form-group">
                    <label class="form-label">Created At</label>
                    <input class="form-control" value="@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")" readonly />
                </div>
                <div class="form-group">
                    <label class="form-label">Updated At</label>
                    <input class="form-control" value="@Model.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")" readonly />
                </div>
            </div>
        }

        <!-- ── Action Buttons ─────────────────────────────────────────── -->
        <div class="form-actions">
            <button type="submit" class="btn-fs-primary" id="btn-submit-fd">
                @(isEdit ? "💾 Update FD" : "✔ Save Fixed Deposit")
            </button>
            <a asp-action="Index" class="btn-fs-secondary" id="btn-cancel-fd">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        // ── Auto-compute Days ─────────────────────────────────────────────
        function computeDays() {
            const d1 = new Date(document.getElementById('fd-deposit-date').value);
            const d2 = new Date(document.getElementById('fd-maturity-date').value);
            if (!isNaN(d1) && !isNaN(d2) && d2 > d1) {
                const days = Math.round((d2 - d1) / 86400000);
                document.getElementById('fd-days').value = days;
                computeInterest(days);
            }
        }

        // ── Auto-compute Simple Interest ─────────────────────────────────
        function computeInterest(days) {
            days = days ?? parseInt(document.getElementById('fd-days').value) || 0;
            const p = parseFloat(document.getElementById('fd-principal').value) || 0;
            const r = parseFloat(document.getElementById('fd-rate').value) || 0;
            const interest = (p * r * days) / 36500;
            const intField = document.getElementById('fd-interest');
            if (intField && !intField.matches(':focus'))
                intField.value = interest.toFixed(2);

            // TDS hint: 10% of interest (editable)
            const tdsField = document.getElementById('fd-tds');
            if (tdsField && !tdsField.matches(':focus') && parseFloat(tdsField.value) === 0)
                tdsField.value = (interest * 0.10).toFixed(2);
        }

        ['fd-deposit-date', 'fd-maturity-date'].forEach(id =>
            document.getElementById(id)?.addEventListener('change', computeDays));
        ['fd-principal', 'fd-rate'].forEach(id =>
            document.getElementById(id)?.addEventListener('input', () => computeInterest(null)));

        // Run once on page load so days show for edit mode
        computeDays();
    </script>
}

<style>
    /* ── Section headers ─────────────────────────────────── */
    .form-section-header {
        font-size: .75rem; font-weight: 700;
        letter-spacing: .08em; text-transform: uppercase;
        color: var(--text-muted);
        padding: .75rem 1.5rem .4rem;
        border-top: 1px solid var(--border);
    }

    /* ── Responsive grids ────────────────────────────────── */
    .form-grid-2 {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem 1.25rem;
        padding: .5rem 1.5rem 1rem;
    }
    .form-grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem 1.25rem;
        padding: .5rem 1.5rem 1rem;
    }

    .form-group   { display: flex; flex-direction: column; gap: .3rem; }
    .form-label   { font-size: .8rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; }
    .form-hint    { font-size: .72rem; color: var(--text-faint, #6b7280); }

    .form-control {
        background: var(--surface-2, rgba(255,255,255,.04));
        border: 1px solid var(--border); border-radius: 8px;
        padding: .5rem .75rem; color: var(--text); font-size: .9rem; width: 100%;
        transition: border-color .15s, box-shadow .15s;
    }
    .form-control:focus {
        outline: none; border-color: var(--accent-blue);
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }
    .form-control[readonly] { opacity: .55; cursor: default; }

    /* ── Prefix / suffix ─────────────────────────────────── */
    .input-prefix-wrap {
        display: flex; align-items: center;
        border: 1px solid var(--border); border-radius: 8px; overflow: hidden;
    }
    .input-prefix, .input-suffix {
        padding: .5rem .65rem; background: rgba(255,255,255,.06);
        color: var(--text-muted); font-size: .85rem; white-space: nowrap; flex-shrink: 0;
    }
    .input-with-prefix, .input-with-suffix { border: none !important; border-radius: 0 !important; box-shadow: none !important; flex: 1; }

    /* ── Form actions ────────────────────────────────────── */
    .form-actions {
        display: flex; gap: .75rem;
        padding: 1rem 1.5rem 1.5rem;
        border-top: 1px solid var(--border);
    }
    .btn-fs-secondary {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .5rem 1.25rem; border-radius: 8px;
        background: transparent; border: 1px solid var(--border);
        color: var(--text-muted); font-size: .88rem; font-weight: 500;
        text-decoration: none; transition: background .15s;
    }
    .btn-fs-secondary:hover { background: rgba(255,255,255,.06); }
</style>
