@model FinancialSystem.WebUI.Models.SignUpViewModel

@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="row justify-content-center" style="min-height: calc(100vh - 220px); padding: 2rem 0;">
    <div class="col-12 col-md-9 col-lg-6 col-xl-5">

        <div class="fs-card p-4 fade-in" style="box-shadow: 0 16px 48px rgba(0,0,0,0.65); border: 1px solid var(--border-soft);">

            <!-- Header -->
            <div class="text-center mb-4">
                <div style="display:inline-flex;width:48px;height:48px;background:linear-gradient(135deg,#22c55e,#0ea5e9);border-radius:12px;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 0 24px rgba(34,197,94,0.35);margin-bottom:.75rem;">
                    ✦
                </div>
                <h2 style="font-size:1.3rem;font-weight:700;color:var(--text);margin-bottom:.2rem;">Create Your Account</h2>
                <p style="font-size:.82rem;color:var(--text-muted);margin:0;">Join FinancialOS — Enterprise Financial Trading Platform</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="fs-alert fs-alert-danger fade-in mb-3">
                    <span>✘</span>
                    <span>@TempData["ErrorMessage"]</span>
                </div>
            }

            <form asp-action="SignUp" method="post" id="signUpForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="fs-alert fs-alert-danger mb-3" role="alert" style="display:none;"></div>

                <div class="row g-3">
                    <!-- Full Name -->
                    <div class="col-12">
                        <label asp-for="FullName" class="fs-form-label">Full Name</label>
                        <input asp-for="FullName" class="fs-form-control" placeholder="e.g. Rahul Sharma" autofocus required />
                        <span asp-validation-for="FullName" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Username -->
                    <div class="col-md-6">
                        <label asp-for="Username" class="fs-form-label">Username</label>
                        <input asp-for="Username" class="fs-form-control" placeholder="e.g. rahul_trader" required />
                        <span asp-validation-for="Username" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Role -->
                    <div class="col-md-6">
                        <label asp-for="Role" class="fs-form-label">Role</label>
                        <select asp-for="Role" class="fs-form-control">
                            <option value="Trader">Trader</option>
                            <option value="Senior Trader">Senior Trader</option>
                            <option value="Settlement Manager">Settlement Manager</option>
                            <option value="Administrator">Administrator</option>
                            <option value="Analyst">Analyst</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-12">
                        <label asp-for="Email" class="fs-form-label">Email Address</label>
                        <input asp-for="Email" class="fs-form-control" type="email" placeholder="e.g. rahul@yourcompany.com" required />
                        <span asp-validation-for="Email" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="fs-form-label">Registered Mobile Number</label>
                        <input asp-for="PhoneNumber" class="fs-form-control" placeholder="e.g. +91 98765 43210" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Password -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="fs-form-label">Password</label>
                        <input asp-for="Password" class="fs-form-control" type="password" placeholder="Min. 6 characters" required />
                        <span asp-validation-for="Password" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="fs-form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" class="fs-form-control" type="password" placeholder="Re-enter password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <!-- OTP Channel -->
                    <div class="col-12">
                        <label class="fs-form-label mb-2">Preferred 2FA OTP Channel</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="d-block p-2 rounded" style="background:rgba(255,255,255,.03);border:1px solid var(--border);cursor:pointer;" id="su-label-mobile">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="radio" asp-for="PreferredOtpChannel" value="Mobile" checked style="accent-color:var(--accent-blue);" onchange="updateSuChannelStyle()" />
                                        <div>
                                            <div style="font-size:.82rem;font-weight:600;color:var(--text);">📱 Mobile SMS</div>
                                            <div style="font-size:.7rem;color:var(--text-muted);">Send OTP via SMS</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                            <div class="col-6">
                                <label class="d-block p-2 rounded" style="background:rgba(255,255,255,.03);border:1px solid var(--border);cursor:pointer;" id="su-label-email">
                                    <div class="d-flex align-items-center gap-2">
                                        <input type="radio" asp-for="PreferredOtpChannel" value="Email" style="accent-color:var(--accent-blue);" onchange="updateSuChannelStyle()" />
                                        <div>
                                            <div style="font-size:.82rem;font-weight:600;color:var(--text);">✉ Email ID</div>
                                            <div style="font-size:.7rem;color:var(--text-muted);">Send OTP via Email</div>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn-fs-primary w-100 justify-content-center py-2" style="font-size:.95rem;font-weight:700;background:linear-gradient(135deg,#22c55e,#16a34a);box-shadow:0 4px 16px rgba(34,197,94,.3);">
                            ✦ Create My Account
                        </button>
                    </div>
                </div>
            </form>

            <!-- Back to Login -->
            <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px solid var(--border);">
                <span style="font-size:.8rem;color:var(--text-muted);">Already have an account?</span>
                <a asp-controller="Account" asp-action="Login"
                   style="font-size:.85rem;font-weight:600;color:var(--accent-blue);text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;">
                    &larr; Back to Sign In
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    function updateSuChannelStyle() {
        const isMobile = document.querySelector('input[name="PreferredOtpChannel"][value="Mobile"]').checked;
        const labelMobile = document.getElementById('su-label-mobile');
        const labelEmail = document.getElementById('su-label-email');
        if (isMobile) {
            labelMobile.style.borderColor = 'var(--accent-blue)';
            labelMobile.style.background = 'rgba(59,130,246,0.12)';
            labelEmail.style.borderColor = 'var(--border)';
            labelEmail.style.background = 'rgba(255,255,255,0.03)';
        } else {
            labelEmail.style.borderColor = 'var(--accent-blue)';
            labelEmail.style.background = 'rgba(59,130,246,0.12)';
            labelMobile.style.borderColor = 'var(--border)';
            labelMobile.style.background = 'rgba(255,255,255,0.03)';
        }
    }

    // Show validation summary if there are server errors
    const valSummary = document.querySelector('[data-valmsg-summary]');
    if (valSummary && valSummary.querySelectorAll('li').length > 0) {
        valSummary.style.display = 'flex';
    }

    updateSuChannelStyle();
</script>
}
