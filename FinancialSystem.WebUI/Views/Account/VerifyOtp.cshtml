@model FinancialSystem.WebUI.Models.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify 2FA OTP";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 220px);">
    <div class="col-12 col-md-8 col-lg-5 col-xl-4">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="fs-alert fs-alert-success fade-in mb-3">
                <span>✔</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <div class="fs-card p-4 fade-in" style="box-shadow: 0 16px 40px rgba(0,0,0,0.6); border: 1px solid var(--border-soft);">
            <div class="text-center mb-4">
                <div style="display:inline-flex;width:48px;height:48px;background:linear-gradient(135deg, rgba(34,197,94,0.2), rgba(16,185,129,0.3));border:1px solid rgba(34,197,94,0.4);border-radius:12px;align-items:center;justify-content:center;font-size:1.5rem;box-shadow:0 0 24px rgba(34,197,94,0.25);margin-bottom:.75rem;">
                    🛡️
                </div>
                <h2 style="font-size:1.35rem;font-weight:700;color:var(--text);margin-bottom:.25rem;">Two-Factor Verification</h2>
                <p style="font-size:.82rem;color:var(--text-muted);margin:0;">
                    Enter the 6-digit verification code sent to your registered @Model.ChannelType.
                </p>
            </div>

            <!-- Destination Card -->
            <div class="p-3 rounded mb-3 text-center" style="background:rgba(255,255,255,0.03);border:1px solid var(--border);">
                <div style="font-size:.75rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;">
                    @(Model.ChannelType == "Email" ? "Registered Email Address" : "Registered Mobile Number")
                </div>
                <div style="font-size:1.05rem;font-weight:700;color:var(--text);font-family:monospace;margin-top:2px;">
                    @Model.MaskedDestination
                </div>
            </div>

            <!-- Demo Instant Delivery Simulation Card -->
            @if (!string.IsNullOrEmpty(Model.SimulatedOtp))
            {
                <div class="p-2 mb-3 rounded d-flex align-items-center justify-content-between" style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.25);">
                    <div style="font-size:.78rem;color:#6ee7b7;">
                        <span>📩 <strong>OTP Dispatched:</strong></span>
                        <span class="badge bg-dark text-success ms-1 px-2 py-1" style="font-size:.9rem;letter-spacing:.15em;font-family:monospace;">@Model.SimulatedOtp</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size:.75rem;" onclick="autoFillOtp('@Model.SimulatedOtp')">
                        Auto-Fill
                    </button>
                </div>
            }

            <form asp-action="VerifyOtp" method="post" id="otpForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="ChannelType" />
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="fs-alert fs-alert-danger mb-3" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="EnteredOtp" class="fs-form-label text-center d-block">Enter 6-Digit OTP</label>
                    <input asp-for="EnteredOtp"
                           id="otpInput"
                           class="fs-form-control text-center py-2"
                           maxlength="6"
                           placeholder="------"
                           style="font-size:1.6rem;letter-spacing:.35em;font-weight:800;font-family:monospace;background:#090d16;"
                           autofocus
                           required
                           pattern="[0-9]{6}" />
                    <span asp-validation-for="EnteredOtp" class="text-danger d-block text-center mt-1" style="font-size:.78rem;"></span>
                </div>

                <button type="submit" class="btn-fs-primary w-100 justify-content-center py-2" style="font-size:.95rem;font-weight:700;background:linear-gradient(135deg, #22c55e, #16a34a);border-color:#16a34a;">
                    ✔ Verify &amp; Sign In
                </button>
            </form>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3" style="border-top:1px dashed var(--border);">
                <form asp-action="ResendOtp" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="username" value="@Model.Username" />
                    <input type="hidden" name="channel" value="@Model.ChannelType" />
                    <button type="submit" class="btn btn-link p-0 text-decoration-none" style="font-size:.8rem;color:var(--accent-blue);">
                        🔄 Resend OTP Code
                    </button>
                </form>

                <a asp-action="Login" style="font-size:.8rem;color:var(--text-muted);text-decoration:none;">
                    &larr; Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function autoFillOtp(code) {
        const input = document.getElementById('otpInput');
        input.value = code;
        input.focus();
    }

    // Auto submit when 6 digits are typed
    document.getElementById('otpInput').addEventListener('input', function(e) {
        this.value = this.value.replace(/[^0-9]/g, '');
        if (this.value.length === 6) {
            document.getElementById('otpForm').submit();
        }
    });
</script>
}
