@model IEnumerable<FinancialSystem.Domain.Entities.GSecTrade>

@{
    ViewData["Title"] = "GSec Deal Tickets";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="fs-alert fs-alert-success fade-in" id="alert-success" role="alert">
        <span>✔</span>
        <span>@TempData["SuccessMessage"]</span>
        <button class="alert-close" onclick="this.parentElement.remove()" aria-label="Close">✕</button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="fs-alert fs-alert-danger fade-in" id="alert-error" role="alert">
        <span>✘</span>
        <span>@TempData["ErrorMessage"]</span>
        <button class="alert-close" onclick="this.parentElement.remove()" aria-label="Close">✕</button>
    </div>
}

<div class="page-header d-flex align-items-start justify-content-between flex-wrap gap-3 fade-in">
    <div>
        <h1>📜 GSec Deal Tickets</h1>
        <p>Government Securities trade ledger — all deals with full SGL / RBI fields.</p>
    </div>
    <a asp-action="Create" class="btn-fs-primary" id="btn-create-gsec">
        <span>＋</span> New Deal
    </a>
</div>

<div class="fs-table-wrap fade-in">
    <div class="fs-card-header">
        <h2>🏛 GSec Trade Register</h2>
        <span style="font-size:.8rem;color:var(--text-muted);">@Model.Count() deals</span>
    </div>

    <div style="overflow-x:auto;">
        <table class="fs-table" id="gsec-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ISIN</th>
                    <th>Script Code</th>
                    <th>Security Name</th>
                    <th>Maturity Date</th>
                    <th>Action</th>
                    <th>Trade Date</th>
                    <th class="text-end">Face Value (₹)</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Yield (%)</th>
                    <th class="text-end">Deal Value (₹)</th>
                    <th class="text-end">Broken Period (₹)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="14">
                            <div class="empty-state">
                                <span class="empty-icon">📭</span>
                                No GSec deals yet. <a asp-action="Create">Create the first deal</a>.
                            </div>
                        </td>
                    </tr>
                }
                @foreach (var deal in Model)
                {
                    <tr>
                        <td class="td-mono td-muted">GSC-@deal.Id</td>
                        <td><span class="isin-code">@deal.Isin</span></td>
                        <td class="td-mono">@deal.ScriptCode</td>
                        <td><span class="inst-name">@deal.SecurityName</span></td>
                        <td class="td-muted">@deal.MaturityDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (deal.Action == FinancialSystem.Domain.Entities.GSecAction.Buy)
                            {
                                <span class="fs-badge badge-buy">⬆ Buy</span>
                            }
                            else
                            {
                                <span class="fs-badge badge-sell">⬇ Sell</span>
                            }
                        </td>
                        <td class="td-muted">@deal.TradeDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end td-bold">@deal.FaceValue.ToString("N2")</td>
                        <td class="text-end td-bold">@deal.Price.ToString("N6")</td>
                        <td class="text-end" style="color:var(--accent-cyan);font-weight:600;">@deal.Yield.ToString("N4")%</td>
                        <td class="text-end" style="color:var(--accent-green);font-weight:600;">@deal.DealValue.ToString("N2")</td>
                        <td class="text-end td-muted">@deal.BrokenPeriod.ToString("N6")</td>
                        <td>
                            @if (deal.Status == FinancialSystem.Domain.Entities.SettlementStatus.Pending)
                            {
                                <span class="fs-badge badge-pending">Pending</span>
                            }
                            else if (deal.Status == FinancialSystem.Domain.Entities.SettlementStatus.Settled)
                            {
                                <span class="fs-badge badge-settled">Settled</span>
                            }
                            else
                            {
                                <span class="fs-badge badge-failed">Failed</span>
                            }
                        </td>
                        <td>
                            <div class="action-group">
                                <a asp-action="Edit" asp-route-id="@deal.Id" class="btn-fs-icon" title="Edit" id="edit-@deal.Id">✏</a>
                                <form asp-action="Delete" asp-route-id="@deal.Id" method="post" style="display:inline;"
                                      onsubmit="return confirm('Delete GSC-@deal.Id ?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-fs-icon btn-danger-icon" title="Delete" id="del-@deal.Id">🗑</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* ── GSec-specific badge colours ──────────────────────── */
    .badge-buy  { background: rgba(34,197,94,.15);  color: #22c55e; border: 1px solid rgba(34,197,94,.3); }
    .badge-sell { background: rgba(239,68,68,.15);  color: #ef4444; border: 1px solid rgba(239,68,68,.3); }

    /* ── Inline action group ─────────────────────────────── */
    .action-group { display: flex; gap: .4rem; align-items: center; }
    .btn-fs-icon  {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 6px;
        background: rgba(255,255,255,.05); border: 1px solid var(--border);
        color: var(--text-muted); font-size: .9rem;
        text-decoration: none; cursor: pointer; transition: background .15s, color .15s;
    }
    .btn-fs-icon:hover { background: rgba(255,255,255,.12); color: var(--text); }
    .btn-danger-icon:hover { background: rgba(239,68,68,.2); color: #ef4444; border-color: rgba(239,68,68,.4); }
</style>
